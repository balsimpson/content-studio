# Use the Convex HTTP Actions URL (ends in .convex.site for cloud).
NUXT_CONVEX_SITE_URL=
# Generate three separate random secrets; never reuse them.
NUXT_STUDIO_PASSWORD=
NUXT_SESSION_PASSWORD=
NUXT_STUDIO_SERVICE_TOKEN=
# Set STUDIO_SERVICE_TOKEN to the same service token in Convex, not in public runtime config.
